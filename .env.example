# Copy to .env.local (dev) or .env (docker compose), or set in Coolify. Never commit real values.

# 32+ random bytes used to encrypt the profile cookie. Generate with: npm run secret
SESSION_SECRET=
# Optional: the previous secret during a rotation, so existing cookies keep working.
SESSION_SECRET_PREVIOUS=

# Public origin of this deployment, exactly as visitors type it (e.g. https://oopswhere.com).
# Required in production: behind Coolify's proxy the app only sees http://, so this decides
# the OAuth callback, Secure cookies, HSTS, the Origin check and the canonical host (other
# hosts such as www. are redirected here). Optional in dev.
SITE_URL=

# USOS API consumer for ZUT — register your own (free, self-service) at
# https://usosapi.zut.edu.pl/developers/ . Without it the login button is disabled.
USOS_ZUT_CONSUMER_KEY=
USOS_ZUT_CONSUMER_SECRET=

# Optional: point ZUT at another USOS API base URL (used by the e2e mock server).
USOS_ZUT_BASE_URL=

# /demo is served only by `npm run dev`. Set to true to expose it in a production build
# (the e2e suite does). Leave unset in real deployments.
ENABLE_DEMO=
