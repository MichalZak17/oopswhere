---
import Base from "@/layouts/Base.astro";
import Wordmark from "@/components/astro/Wordmark.astro";
import { localePath, t } from "@/i18n";

const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pl";
const dict = t(lang);
---

<Base lang={lang} title={dict.notFound.title} noindex>
    <main id="main" class="nf">
        <Wordmark href={localePath(lang, "/")} size="l" intro />
        <h1>{dict.notFound.title}</h1>
        <p>{dict.notFound.body}</p>
        <a class="btn btn-ghost" href={localePath(lang, "/")}>
            {dict.notFound.back}
        </a>
    </main>
</Base>

<style>
    .nf {
        display: grid;
        justify-items: start;
        gap: 18px;
        max-width: 640px;
        margin: 0 auto;
        padding: 18vh var(--gutter) 0;
    }
    h1 {
        margin-top: 40px;
        font-size: clamp(2.8rem, 2rem + 3vw, 4.4rem);
        font-weight: 680;
        letter-spacing: -0.05em;
        line-height: 1;
    }
    p {
        color: var(--ink-2);
        font-size: 1.1rem;
    }
</style>
