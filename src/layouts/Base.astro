---
import { Font } from "astro:assets";
import "@/styles/tokens.css";
import "@/styles/base.css";
import "@/styles/view-transitions.css";
import { t, type Lang } from "@/i18n";
import { THEME_COLOR } from "@/lib/theme";
import { siteOrigin } from "@/lib/env";
import { analyticsKey } from "@/lib/analytics/server";
import ConsentBanner from "@/components/astro/ConsentBanner.astro";

interface Props {
    lang: Lang;
    title?: string;
    description?: string;
    /** Path without the /en prefix, for hreflang alternates. */
    path?: string;
    noindex?: boolean;
}

const { lang, title, description, path = "/", noindex = false } = Astro.props;
const dict = t(lang);
const theme = Astro.locals.theme;
const site = siteOrigin(Astro.url);
const plHref = new URL(path, site).toString();
const enHref = new URL(path === "/" ? "/en/" : `/en${path}`, site).toString();
const analytics = analyticsKey();
const consent = Astro.locals.consent;
// Global Privacy Control counts as "no" until the visitor turns analytics on themselves
// (on the privacy page), so they never see the question.
const askConsent =
    analytics !== null && consent === null && Astro.request.headers.get("sec-gpc") !== "1";
---

<!doctype html>
<html
    lang={lang}
    data-theme={theme === "auto" ? undefined : theme}
    data-ph={analytics}
    data-consent={consent ?? undefined}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title ?? dict.meta.title}</title>
        <meta name="description" content={description ?? dict.meta.description} />
        <meta name="color-scheme" content={theme === "auto" ? "light dark" : theme} />
        {theme === "auto" ? (
            <>
                <meta
                    name="theme-color"
                    media="(prefers-color-scheme: light)"
                    content={THEME_COLOR.light}
                />
                <meta
                    name="theme-color"
                    media="(prefers-color-scheme: dark)"
                    content={THEME_COLOR.dark}
                />
            </>
        ) : (
            <meta name="theme-color" content={THEME_COLOR[theme]} />
        )}
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="alternate" hreflang="pl" href={plHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={plHref} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta property="og:title" content={title ?? dict.meta.title} />
        <meta property="og:description" content={description ?? dict.meta.description} />
        <meta property="og:type" content="website" />
        <Font cssVariable="--font-sans" preload />
    </head>
    <body>
        <a class="skip-link" href="#main">
            {lang === "pl" ? "Przejdź do treści" : "Skip to content"}
        </a>
        <slot />
        {askConsent && <ConsentBanner lang={lang} path={path} />}
        <script>
            import { initAnalytics } from "@/lib/analytics/client";

            initAnalytics();
        </script>
    </body>
</html>
