---
import Base from "@/layouts/Base.astro";
import AppHeader from "./AppHeader.astro";
import Footer from "./Footer.astro";
import LoginButton from "./LoginButton.astro";
import SchedulePreview from "./SchedulePreview.astro";
import { localePath, t, type Lang } from "@/i18n";
import { demoEnabled } from "@/lib/env";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const landing = t(lang).landing;
const authCode = Astro.url.searchParams.get("auth");
const error =
    authCode && authCode in landing.errors
        ? landing.errors[authCode as keyof typeof landing.errors]
        : null;
const home = localePath(lang, "/");
---

<Base lang={lang} path="/">
    <AppHeader lang={lang} profile={null} path="/" />
    <main id="main" class="landing">
        {error && (
            <p class="auth-error" role="alert">
                {error}
            </p>
        )}

        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-inner page-width">
                <div class="hero-copy">
                    <p class="eyebrow">
                        <span class="signal-dot" aria-hidden="true"></span>
                        {landing.eyebrow}
                    </p>
                    <h1 id="hero-title">
                        {landing.title.map((line, index) => (
                            <span
                                class:list={[
                                    "title-line",
                                    { accent: index === landing.title.length - 1 },
                                ]}
                            >
                                {line}
                            </span>
                        ))}
                    </h1>
                    <p class="hero-lead">{landing.lead}</p>
                    <div class="hero-actions">
                        <LoginButton lang={lang} returnTo={home} />
                        {demoEnabled() && (
                            <a class="btn btn-ghost demo-link" href={localePath(lang, "/demo")}>
                                {landing.demo} <span aria-hidden="true">↗</span>
                            </a>
                        )}
                    </div>
                    <p class="hero-footnote">{landing.heroNote}</p>
                </div>
                <div class="hero-stage">
                    <div class="stage-orbit" aria-hidden="true"></div>
                    <div class="stage-label" aria-hidden="true">
                        OOPS / WHERE / NEXT
                    </div>
                    <SchedulePreview lang={lang} />
                    <div class="stage-caption">
                        <span aria-hidden="true">↳</span>
                        <p>{landing.previewCaption}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="answer-strip" aria-label={landing.stripLabel}>
            <div class="page-width strip-inner">
                {landing.strip.map((item, index) => (
                    <div class="strip-item">
                        <span class="strip-index">0{index + 1}</span>
                        <span>{item}</span>
                        <span class="strip-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </div>
                ))}
            </div>
        </section>

        <section class="features page-width" id="inside" aria-labelledby="features-title">
            <div class="section-intro">
                <div>
                    <p class="section-kicker">{landing.featuresKicker}</p>
                    <h2 id="features-title">{landing.featuresTitle}</h2>
                </div>
                <p>{landing.featuresLead}</p>
            </div>
            <div class="feature-grid">
                <article class="feature-card next-card">
                    <div class="feature-copy">
                        <span class="feature-no">01 / {landing.features.next.label}</span>
                        <h3>{landing.features.next.title}</h3>
                        <p>{landing.features.next.body}</p>
                    </div>
                    <div class="next-art" aria-hidden="true">
                        <span class="art-overline">{landing.features.next.artLabel}</span>
                        <div class="next-time">
                            11:30<span>—</span>13:00
                        </div>
                        <div class="next-divider"></div>
                        <div class="next-destination">
                            <span>{landing.features.next.artRoom}</span>
                            <strong>WI1 303</strong>
                            <span class="next-arrow">↗</span>
                        </div>
                    </div>
                </article>
                <article class="feature-card week-card">
                    <div class="feature-copy">
                        <span class="feature-no">02 / {landing.features.week.label}</span>
                        <h3>{landing.features.week.title}</h3>
                        <p>{landing.features.week.body}</p>
                    </div>
                    <div class="week-art" aria-hidden="true">
                        {landing.features.week.days.map((day, index) => (
                            <div class="week-day">
                                <span>{day}</span>
                                <i class={`week-block b${index}-1`}></i>
                                <i class={`week-block b${index}-2`}></i>
                            </div>
                        ))}
                    </div>
                </article>
                <article class="feature-card clash-card">
                    <div class="feature-copy">
                        <span class="feature-no">03 / {landing.features.clash.label}</span>
                        <h3>{landing.features.clash.title}</h3>
                        <p>{landing.features.clash.body}</p>
                    </div>
                    <div class="clash-art" aria-hidden="true">
                        <span class="clash-hour">09:40</span>
                        <div class="clash-events">
                            <div data-type="LB">
                                <small>LB · 09:40</small>
                                <strong>WI1 303</strong>
                            </div>
                            <div data-type="WK">
                                <small>WK · 09:40</small>
                                <strong>WI2 100</strong>
                            </div>
                        </div>
                        <span class="clash-hour">11:10</span>
                    </div>
                </article>
                <article class="feature-card phone-card">
                    <div class="feature-copy">
                        <span class="feature-no">04 / {landing.features.phone.label}</span>
                        <h3>{landing.features.phone.title}</h3>
                        <p>{landing.features.phone.body}</p>
                    </div>
                    <div class="phone-art" aria-hidden="true">
                        <div class="phone-screen">
                            <div class="phone-status">
                                <span>9:41</span>
                                <span>●●●</span>
                            </div>
                            <div class="phone-wordmark">
                                oopswhere<span>●</span>
                            </div>
                            <p>{landing.features.phone.artLabel}</p>
                            <div class="phone-event">
                                <small>11:30—13:00 · LB</small>
                                <strong>WI1 303</strong>
                                <span>{landing.features.phone.artRoom} ↗</span>
                            </div>
                            <div class="phone-line"></div>
                            <div class="phone-line short"></div>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="how" aria-labelledby="how-title">
            <div class="page-width how-inner">
                <div class="how-heading">
                    <p class="section-kicker">{landing.promiseKicker}</p>
                    <h2 id="how-title">{landing.promiseTitle}</h2>
                    <p>{landing.promiseLead}</p>
                </div>
                <ol class="steps">
                    {landing.promise.map(([title, body], index) => (
                        <li>
                            <span class="step-number">0{index + 1}</span>
                            <div>
                                <h3>{title}</h3>
                                <p>{body}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="faq page-width" aria-labelledby="faq-title">
            <div class="faq-heading">
                <p class="section-kicker">{landing.faqKicker}</p>
                <h2 id="faq-title">{landing.faqTitle}</h2>
                <p>{landing.faqLead}</p>
            </div>
            <div class="questions">
                {landing.faq.map(([question, answer], index) => (
                    <details>
                        <summary>
                            <span class="question-index">0{index + 1}</span>
                            <span>{question}</span>
                            <span class="question-plus" aria-hidden="true">
                                +
                            </span>
                        </summary>
                        <p>{answer}</p>
                    </details>
                ))}
            </div>
        </section>

        <section class="closing page-width" aria-labelledby="closing-title">
            <div class="closing-copy">
                <p class="section-kicker">{landing.closingKicker}</p>
                <h2 id="closing-title">{landing.closingTitle}</h2>
                <p>{landing.closingBody}</p>
                <div class="closing-actions">
                    <LoginButton lang={lang} returnTo={home} label={landing.closingCta} />
                    {demoEnabled() && <a href={localePath(lang, "/demo")}>{landing.demo} ↗</a>}
                </div>
            </div>
            <div class="closing-symbol" aria-hidden="true">
                <span>?</span>
                <span>→</span>
                <span>✓</span>
            </div>
        </section>
    </main>
    <Footer lang={lang} />
</Base>

<script>
    if (
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
        "IntersectionObserver" in window
    ) {
        const revealTargets = document.querySelectorAll<HTMLElement>(
            ".strip-item, .features .section-intro > *, .feature-card, .how-heading, .steps li, .faq-heading, .questions details, .closing-copy",
        );
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    const element = entry.target as HTMLElement;
                    const siblings = element.parentElement?.children;
                    const index = siblings ? [...siblings].indexOf(element) : 0;
                    element.animate(
                        [
                            { opacity: 0, transform: "translateY(24px)" },
                            { opacity: 1, transform: "translateY(0)" },
                        ],
                        {
                            duration: 560,
                            delay: Math.min(index * 65, 195),
                            easing: "cubic-bezier(0.2, 0, 0, 1)",
                            fill: "backwards",
                        },
                    );
                    observer.unobserve(element);
                }
            },
            { threshold: 0.12, rootMargin: "0px 0px -32px 0px" },
        );
        revealTargets.forEach((element) => observer.observe(element));
    }
</script>

<style>
    .page-width {
        width: min(calc(100% - 2 * var(--gutter)), var(--page-max));
        margin-inline: auto;
    }
    .auth-error {
        width: min(calc(100% - 2 * var(--gutter)), var(--page-max));
        margin: 12px auto 0;
        padding: 12px 16px;
        border: 1px solid var(--accent);
        border-radius: var(--radius-m);
        background: color-mix(in oklch, var(--accent) 10%, var(--paper));
    }
    .hero {
        overflow: hidden;
        border-top: 1px solid var(--rule);
    }
    .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.03fr) minmax(0, 0.97fr);
        align-items: center;
        gap: clamp(40px, 5.4vw, 84px);
        min-height: 750px;
        padding-block: 72px 84px;
    }
    .eyebrow,
    .section-kicker {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--accent-text);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.095em;
        text-transform: uppercase;
    }
    .signal-dot {
        position: relative;
        width: 7px;
        height: 7px;
        flex: none;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent) 14%, transparent);
    }
    .signal-dot::after {
        content: "";
        position: absolute;
        inset: -5px;
        border: 1px solid var(--accent);
        border-radius: 50%;
        opacity: 0;
    }
    h1 {
        margin-top: 24px;
        font-size: clamp(4.4rem, 6.5vw, 7.7rem);
        font-weight: 730;
        letter-spacing: -0.076em;
        line-height: 0.92;
    }
    .title-line {
        display: block;
        white-space: nowrap;
    }
    .title-line.accent {
        color: var(--accent-text);
    }
    .hero-lead {
        max-width: 31em;
        margin-top: 31px;
        color: var(--ink-2);
        font-size: clamp(1.08rem, 1.5vw, 1.28rem);
        line-height: 1.55;
    }
    .hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 31px;
    }
    .demo-link {
        height: 52px;
        padding: 0 21px;
        font-size: 1.02rem;
    }
    .hero-footnote {
        margin-top: 17px;
        color: var(--ink-3);
        font-size: 0.82rem;
    }
    .hero-stage {
        position: relative;
        isolation: isolate;
        min-width: 0;
        padding: 25px 21px 30px;
    }
    .stage-orbit {
        position: absolute;
        z-index: -1;
        inset: -35px -100px -55px -35px;
        border: 1px solid var(--rule);
        border-radius: 50%;
        transform: rotate(-21deg);
    }
    .stage-orbit::after {
        content: "";
        position: absolute;
        inset: 35px;
        border: 1px solid var(--rule);
        border-radius: 50%;
    }
    .stage-label {
        position: absolute;
        top: -13px;
        right: 18px;
        color: var(--ink-3);
        font-size: 0.64rem;
        font-weight: 650;
        letter-spacing: 0.16em;
        rotate: 5deg;
    }
    .stage-caption {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin: 15px 7px 0 auto;
        width: max-content;
        max-width: 25em;
        color: var(--ink-3);
        font-size: 0.79rem;
    }
    .stage-caption span {
        color: var(--accent-text);
        font-size: 1.5rem;
        line-height: 0.7;
    }
    .answer-strip {
        border-block: 1px solid var(--rule-strong);
        background: var(--paper-sunk);
    }
    .strip-inner {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .strip-item {
        display: flex;
        align-items: center;
        gap: 15px;
        min-height: 89px;
        padding: 20px 28px;
        font-size: 1rem;
        font-weight: 640;
        letter-spacing: -0.014em;
    }
    .strip-item:first-child {
        padding-left: 0;
    }
    .strip-item + .strip-item {
        border-left: 1px solid var(--rule-strong);
    }
    .strip-index {
        color: var(--accent-text);
        font-size: 0.72rem;
        font-weight: 750;
        font-variant-numeric: tabular-nums;
    }
    .strip-arrow {
        margin-left: auto;
        color: var(--ink-3);
        font-size: 1.1rem;
        font-weight: 400;
    }
    .features {
        padding-block: 126px 140px;
    }
    .section-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 330px);
        align-items: end;
        gap: 50px;
        margin-bottom: 41px;
    }
    .section-intro h2,
    .how h2,
    .faq h2,
    .closing h2 {
        margin-top: 16px;
        font-size: clamp(2.6rem, 4vw, 4.7rem);
        font-weight: 700;
        letter-spacing: -0.065em;
        line-height: 1;
    }
    .section-intro > p,
    .faq-heading > p:last-child {
        padding-bottom: 5px;
        color: var(--ink-2);
        font-size: 1.07rem;
        line-height: 1.6;
    }
    .feature-grid {
        display: grid;
        grid-template-columns: 1.12fr 0.88fr;
        gap: 14px;
    }
    .feature-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 410px;
        padding: clamp(25px, 3.5vw, 43px);
        border: 1px solid var(--rule-strong);
        border-radius: 14px;
        background: var(--paper-raised);
    }
    .feature-card::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
    }
    .feature-copy {
        position: relative;
        z-index: 1;
        max-width: 410px;
    }
    .feature-no {
        color: var(--accent-text);
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .feature-card h3 {
        margin-top: 14px;
        font-size: clamp(1.8rem, 2.4vw, 2.6rem);
        font-weight: 690;
        letter-spacing: -0.05em;
        line-height: 1.04;
    }
    .feature-card p {
        max-width: 31em;
        margin-top: 12px;
        color: var(--ink-2);
        line-height: 1.5;
    }
    .next-card,
    .phone-card {
        background: var(--paper-sunk);
    }
    .next-art {
        align-self: flex-end;
        width: min(100%, 470px);
        margin-top: auto;
        padding: 22px 24px;
        border: 1px solid var(--rule-strong);
        border-radius: 10px;
        background: var(--paper-raised);
        box-shadow: var(--shadow-lift);
        transform: rotate(-2deg) translate(13px, 8px);
    }
    .art-overline {
        color: var(--accent-text);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }
    .next-time {
        margin-top: 3px;
        font-size: clamp(2.8rem, 5vw, 5rem);
        font-weight: 730;
        letter-spacing: -0.075em;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .next-time span {
        padding-inline: 0.04em;
        color: var(--ink-faint);
        font-weight: 400;
    }
    .next-divider {
        height: 1px;
        margin-block: 15px;
        background: var(--rule-strong);
    }
    .next-destination {
        display: flex;
        align-items: baseline;
        gap: 13px;
    }
    .next-destination span:first-child {
        color: var(--ink-3);
        font-size: 0.77rem;
    }
    .next-destination strong {
        font-size: 1.35rem;
        letter-spacing: -0.04em;
    }
    .next-arrow {
        margin-left: auto;
        color: var(--accent-text);
        font-size: 1.8rem;
        line-height: 1;
    }
    .week-art {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 6px;
        height: 142px;
        margin-top: auto;
        padding-top: 25px;
    }
    .week-day {
        display: flex;
        flex-direction: column;
        gap: 7px;
        border-top: 1px solid var(--rule-strong);
        padding-top: 8px;
    }
    .week-day > span {
        color: var(--ink-3);
        font-size: 0.66rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    .week-block {
        display: block;
        height: 25px;
        border-radius: 4px;
        background: oklch(var(--tint-strong-l) var(--tint-strong-c) 255);
        border-left: 3px solid oklch(var(--rule-l) var(--rule-c) 255);
    }
    .week-block:nth-of-type(2) {
        height: 37px;
        background: oklch(var(--tint-strong-l) var(--tint-strong-c) 150);
        border-color: oklch(var(--rule-l) var(--rule-c) 150);
    }
    .week-day:nth-child(2) .week-block:last-child,
    .week-day:nth-child(4) .week-block:last-child {
        opacity: 0;
    }
    .week-day:nth-child(3) .week-block:first-of-type,
    .week-day:nth-child(5) .week-block:first-of-type {
        margin-top: 17px;
    }
    .clash-card,
    .phone-card {
        min-height: 370px;
    }
    .clash-art {
        margin-top: auto;
        padding-top: 28px;
    }
    .clash-hour {
        display: block;
        color: var(--ink-3);
        font-size: 0.67rem;
        font-variant-numeric: tabular-nums;
    }
    .clash-events {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
        margin: 6px 0;
        padding: 8px 0;
        border-block: 1px solid var(--rule);
    }
    .clash-events > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 82px;
        padding: 11px;
        border-left: 3px solid oklch(var(--rule-l) var(--rule-c) var(--h));
        border-radius: 5px;
        background: oklch(var(--tint-l) var(--tint-c) var(--h));
    }
    .clash-events small {
        color: var(--ink-2);
        font-size: 0.7rem;
    }
    .clash-events strong {
        font-size: 1rem;
        letter-spacing: -0.02em;
    }
    .phone-card .feature-copy {
        max-width: 50%;
    }
    .phone-art {
        position: absolute;
        right: 8%;
        bottom: -98px;
        width: 210px;
        height: 320px;
        padding: 8px;
        border: 5px solid oklch(0.23 0.01 60);
        border-radius: 31px;
        background: oklch(0.23 0.01 60);
        transform: rotate(8deg);
        box-shadow: 0 16px 40px -18px oklch(0.2 0.01 60 / 0.4);
    }
    .phone-screen {
        height: 100%;
        padding: 13px 11px;
        border-radius: 21px;
        background: var(--paper-raised);
    }
    .phone-status {
        display: flex;
        justify-content: space-between;
        font-size: 0.52rem;
        font-weight: 700;
    }
    .phone-wordmark {
        margin-top: 20px;
        font-size: 0.88rem;
        font-weight: 750;
        letter-spacing: -0.05em;
    }
    .phone-wordmark span {
        color: var(--accent-text);
    }
    .phone-screen p {
        margin-top: 17px;
        color: var(--ink-3);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }
    .phone-event {
        display: grid;
        gap: 4px;
        margin-top: 8px;
        padding: 12px 10px;
        border-left: 3px solid var(--accent);
        border-radius: 5px;
        background: var(--paper-sunk);
    }
    .phone-event small {
        color: var(--ink-2);
        font-size: 0.58rem;
    }
    .phone-event strong {
        font-size: 1.28rem;
        letter-spacing: -0.04em;
    }
    .phone-event span {
        color: var(--accent-text);
        font-size: 0.58rem;
    }
    .phone-line {
        width: 100%;
        height: 5px;
        margin-top: 12px;
        border-radius: 3px;
        background: var(--rule);
    }
    .phone-line.short {
        width: 72%;
        margin-top: 7px;
    }
    .how {
        background: oklch(0.22 0.012 60);
        color: oklch(0.97 0.005 85);
    }
    .how-inner {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: 8%;
        padding-block: 112px;
    }
    .how .section-kicker {
        color: oklch(0.77 0.14 36);
    }
    .how-heading > p:last-child {
        max-width: 22em;
        margin-top: 21px;
        color: oklch(0.77 0.005 80);
        font-size: 1.08rem;
        line-height: 1.6;
    }
